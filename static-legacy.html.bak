

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Scroll Sequence — Pihu Vijaywargiya</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">

<style>
:root{
  --bg:#0A0A0A;
  --text:#F2EFEA;
  --muted:#9A968F;
  --gold:#C9A24B;
  --serif:'Playfair Display', Georgia, serif;
  --sans:'Inter', Arial, Helvetica, sans-serif;
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html,
body{
  width:100%;
  min-height:100%;
  background:var(--bg);
  color:var(--text);
  font-family:var(--sans);
}

body{
  overflow-x:hidden;
}

/* =========================
   SCROLL TRACK
========================= */

#track{
  position:relative;
  height:500vh;
}

/* =========================
   STICKY STAGE
========================= */

#stage{
  position:sticky;
  top:0;
  width:100%;
  height:100vh;
  overflow:hidden;
  background:var(--bg);
}

/* =========================
   CANVAS
========================= */

#frame{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  display:block;
  object-fit:cover;
  z-index:1;
}

/* =========================
   FINAL BACKGROUND
========================= */

#after-background{
  position:absolute;
  inset:0;
  z-index:2;

  background-image:url("./images/portfolio-bg.jpg");
  background-size:cover;
  background-position:center center;
  background-repeat:no-repeat;

  opacity:0;
  transition:opacity .8s ease;

  pointer-events:none;
}

/* =========================
   DARK SCRIM
========================= */

#scrim{
  position:absolute;
  inset:0;
  z-index:3;
  pointer-events:none;

  background:
    linear-gradient(
      to bottom,
      rgba(0,0,0,.15),
      rgba(0,0,0,.35)
    );
}

#after-background.visible{
  opacity:1;
}

/* =========================
   HERO
========================= */

.hero{
  position:absolute;
  left:8vw;
  bottom:10vh;
  z-index:10;
  pointer-events:none;
}

.hero h1{
  font-family:var(--serif);
  font-size:clamp(48px,8vw,130px);
  line-height:.9;
  letter-spacing:.02em;
  font-weight:600;
}

.hero p{
  margin-top:20px;
  color:var(--muted);
  font-size:14px;
  letter-spacing:.16em;
  text-transform:uppercase;
}

/* =========================
   HOTSPOTS
========================= */

.hotspot{
  position:absolute;
  z-index:20;

  width:26px;
  height:26px;

  border:2px solid #FFFFFF;
  border-radius:50%;

  background:rgba(255,255,255,.35);

  opacity:0;
  transform:scale(.5);

  transition:
    opacity .4s ease,
    transform .45s cubic-bezier(.22,1,.36,1),
    background .45s ease,
    box-shadow .45s ease;

  cursor:pointer;
}

.hotspot.active{
  opacity:1;
  transform:scale(1);
  animation: hotspot-glow 1.8s ease-in-out infinite;
}

/* Premium hover state — the resting pulse hands off to a
   larger, slower, more deliberate one so the hover reads as
   an intentional response rather than a glitch. */
.hotspot.active:hover{
  animation: hotspot-glow-hover 1.4s ease-in-out infinite;
  background:rgba(255,255,255,.6);
  transform:scale(1.45);
  box-shadow: 0 0 26px 4px rgba(255,255,255,.35);
}

.hotspot::after{
  content:"";
  position:absolute;
  inset:-10px;

  border:1px solid rgba(255,255,255,.5);
  border-radius:50%;

  opacity:0;
}

.hotspot.active::after{
  animation: hotspot-ring 1.8s ease-out infinite;
}

.hotspot.active:hover::after{
  animation: hotspot-ring-hover 1.4s ease-out infinite;
  border-color:rgba(255,255,255,.75);
}

@keyframes hotspot-glow{
  0%,100%{
    box-shadow: 0 0 0 0 rgba(255,255,255,.5);
  }
  50%{
    box-shadow: 0 0 0 12px rgba(255,255,255,0);
  }
}

@keyframes hotspot-glow-hover{
  0%,100%{
    box-shadow: 0 0 0 0 rgba(255,255,255,.6), 0 0 26px 4px rgba(255,255,255,.35);
  }
  50%{
    box-shadow: 0 0 0 18px rgba(255,255,255,0), 0 0 32px 8px rgba(255,255,255,.45);
  }
}

@keyframes hotspot-ring{
  0%{
    transform: scale(1);
    opacity:.7;
  }
  70%{
    transform: scale(2.1);
    opacity:0;
  }
  100%{
    transform: scale(2.1);
    opacity:0;
  }
}

@keyframes hotspot-ring-hover{
  0%{
    transform: scale(1);
    opacity:.85;
  }
  70%{
    transform: scale(2.6);
    opacity:0;
  }
  100%{
    transform: scale(2.6);
    opacity:0;
  }
}

.hotspot-label{
  position:absolute;
  top:calc(100% + 14px);
  left:50%;
  transform:translateX(-50%) scale(1);
  transform-origin:top center;

  white-space:nowrap;

  color:#FFFFFF;

  font-size:14px;
  font-weight:600;
  letter-spacing:.12em;
  text-transform:uppercase;
  text-shadow: 0 1px 6px rgba(0,0,0,.65), 0 0 18px rgba(0,0,0,.35);

  pointer-events:none;

  opacity:0;

  transition:
    opacity .4s ease,
    transform .45s cubic-bezier(.22,1,.36,1);
}

.hotspot.active .hotspot-label{
  opacity:.8;
  animation: hotspot-label-pulse 1.8s ease-in-out infinite;
}

.hotspot.active:hover .hotspot-label{
  opacity:1;
  transform:translateX(-50%) scale(1.08);
  animation:none;
}

@keyframes hotspot-label-pulse{
  0%,100%{
    opacity:.65;
  }
  50%{
    opacity:1;
  }
}

/* Hotspot positions — each sits in open step surface next to
   its object, never on top of it, so the circle + label stay
   fully legible against the concrete. */

#hs-ge{
  left:77%;
  top:75%;
}

#hs-wake{
  left:47%;
  top:55%;
}

#hs-studio{
  left:30%;
  top:6%;
}

#hs-ma{
  left:88%;
  top:75%;
}

#hs-noumena{
  left:71%;
  top:66%;
}

#hs-feature{
  left:57%;
  top:65%;
}

/* =========================
   SECTIONS
========================= */

.sections-wrapper{
  position:relative;
  z-index:20;

  background-image:url("./images/portfolio-bg.jpg");
  background-size:cover;
  background-position:center top;
  background-repeat:no-repeat;
  background-attachment:fixed;
}

.section{
  min-height:100vh;

  display:flex;
  align-items:center;

  padding:10vh 8vw;

  background:rgba(10,10,10,.18);
}

.section-inner{
  max-width:900px;
}

/* =========================
   SKILLS
========================= */

#skills-panel{
  position:fixed;
  right:8vw;
  top:50%;
  transform:translateY(-50%);

  width:240px;

  z-index:100;

  opacity:0;
  pointer-events:none;

  transition:opacity .6s ease;
}

#skills-panel.visible{
  opacity:1;
}

.skills-title{
  margin-bottom:24px;

  color:var(--gold);

  font-size:54px;
  letter-spacing:.2em;
  text-transform:uppercase;
}

.skills-list{
  display:flex;
  flex-direction:column;
  gap:10px;

  color:var(--text);

  font-size:16px;
  line-height:1.4;

  transition:
    opacity .35s ease,
    transform .35s ease;
}

.skills-list.is-swapping{
  opacity:0;
  transform:translateY(6px);
}

.section-number{
  margin-bottom:20px;

  color:var(--gold);

  font-size:12px;
  letter-spacing:.2em;
  text-transform:uppercase;
}

.section h2{
  font-family:var(--serif);
  font-size:clamp(48px,7vw,110px);
  line-height:.9;
  letter-spacing:.01em;
  font-weight:600;
  margin-bottom:18px;
}

.section-role{
  font-size:14px;
  color:var(--muted);
  letter-spacing:.03em;
  margin-bottom:24px;
}

.section-role span{
  color:var(--text);
}

.badge{
  display:inline-block;
  margin-bottom:20px;

  color:var(--gold);

  font-size:11px;
  letter-spacing:.16em;
  text-transform:uppercase;

  border-bottom:1px solid var(--gold);
  padding-bottom:4px;
}

.section p{
  max-width:650px;

  color:var(--muted);

  font-size:18px;
  line-height:1.6;
}

/* =========================
   METRIC CALLOUTS
========================= */

.metrics{
  display:flex;
  flex-wrap:wrap;
  gap:44px;

  margin:34px 0 8px;
}

.metric-value{
  font-family:var(--serif);
  font-weight:600;
  color:var(--gold);
  font-size:clamp(26px,3vw,40px);
  line-height:1;
}

.metric-label{
  margin-top:8px;

  color:var(--muted);

  font-size:11px;
  letter-spacing:.12em;
  text-transform:uppercase;
}

/* =========================
   TECH TAGS
========================= */

.tags{
  display:flex;
  flex-wrap:wrap;
  gap:10px;

  margin-top:32px;
}

.tag{
  color:var(--text);

  font-size:11px;
  letter-spacing:.08em;
  text-transform:uppercase;

  border:1px solid rgba(201,162,75,.35);
  border-radius:999px;
  padding:7px 16px;
}

/* =========================
   MOBILE
========================= */

@media(max-width:700px){

  #track{
    height:500vh;
  }

  .hero{
    left:6vw;
    bottom:8vh;
  }

  .hero h1{
    font-size:18vw;
  }

  .section{
    padding:8vh 6vw;
  }

  .section h2{
    font-size:16vw;
  }

  .section p{
    font-size:16px;
  }

  #skills-panel{
    right:6vw;
    width:180px;
  }

  .skills-list{
    font-size:13px;
  }

  .metrics{
    gap:28px;
  }

  .metric-value{
    font-size:28px;
  }
}

/* =========================
   REDUCED MOTION
========================= */

@media(prefers-reduced-motion:reduce){

  html{
    scroll-behavior:auto;
  }

  #after-background{
    opacity:1;
  }

}
</style>
</head>

<body>

<!-- =========================
     SCROLL SEQUENCE
========================= -->

<div id="track">

  <div id="stage">

    <canvas id="frame"></canvas>

    <div id="after-background"></div>

    <div id="scrim"></div>


    <!-- HERO -->

    <div class="hero">
      <h1>Pihu<br>Vijaywargiya</h1>

      <p>
        Selected Work
      </p>
    </div>


    <!-- HOTSPOTS -->

    <div
      class="hotspot"
      id="hs-ge"
      data-target="ge-vernova"
      aria-label="GE Vernova SWE">
      <span class="hotspot-label">GE Vernova SWE</span>
    </div>

    <div
      class="hotspot"
      id="hs-wake"
      data-target="wakewatch"
      aria-label="Hackathon Win">
      <span class="hotspot-label">Hackathon Win</span>
    </div>

    <div
      class="hotspot"
      id="hs-studio"
      data-target="studio1"
      aria-label="Startup SWE">
      <span class="hotspot-label">Startup SWE</span>
    </div>

    <div
      class="hotspot"
      id="hs-ma"
      data-target="ma-ai"
      aria-label="Full Stack Project">
      <span class="hotspot-label">Full Stack Project</span>
    </div>

    <div
      class="hotspot"
      id="hs-noumena"
      data-target="noumena"
      aria-label="Cybersecurity Intern">
      <span class="hotspot-label">Cybersecurity Intern</span>
    </div>

    <div
      class="hotspot"
      id="hs-feature"
      data-target="feature"
      aria-label="Tech Feature">
      <span class="hotspot-label">Tech Feature</span>
    </div>

  </div>

</div>


<!-- =========================
     PORTFOLIO SECTIONS
========================= -->

<div class="sections-wrapper">

  <!-- SKILLS -->

  <div id="skills-panel">

    <div class="skills-title">
      SKILLS
    </div>

    <div class="skills-list"></div>

  </div>


  <section
    class="section"
    id="ge-vernova">

    <div class="section-inner">

      <div class="section-number">
        01 — GE Vernova
      </div>

      <h2>
        National Grid Infrastructure
      </h2>

      <div class="section-role">
        Software Engineer &amp; Technical Consultant, <span>GE Vernova</span> — Industrial Placement, 2026–2027
      </div>

      <p>
        Building customer-side software for real-time national energy grid
        management systems — infrastructure with zero margin for failure.
        Deploying and orchestrating containerised services across cloud
        infrastructure, resolving production incidents on the command line,
        and translating technical analysis into strategic recommendations
        for engineering, operations and customer-facing stakeholders.
      </p>

      <div class="metrics">
        <div>
          <div class="metric-value">National</div>
          <div class="metric-label">Grid Scale</div>
        </div>
        <div>
          <div class="metric-value">Real-Time</div>
          <div class="metric-label">Safety-Critical Systems</div>
        </div>
        <div>
          <div class="metric-value">24/7</div>
          <div class="metric-label">Production Monitoring</div>
        </div>
      </div>

      <div class="tags">
        <div class="tag">Python</div>
        <div class="tag">C++</div>
        <div class="tag">Kubernetes</div>
        <div class="tag">Linux / CLI</div>
      </div>

    </div>

  </section>


  <section
    class="section"
    id="wakewatch">

    <div class="section-inner">

      <div class="section-number">
        02 — WakeWatch
      </div>

      <div class="badge">
        Most Innovative Startup — University Incubator
      </div>

      <h2>
        WakeWatch
      </h2>

      <div class="section-role">
        Founder &amp; CTO, <span>Senior Data Engineer</span>
      </div>

      <p>
        ML-powered drowsiness detection built on an AWS pipeline of S3,
        DynamoDB, Lambda and Redis. Insurance-ready analytics dashboards
        translate underwriting criteria into data specifications for
        actuarial stakeholders. Delivered a commercial pitch to an investor
        panel after completing the university's top startup incubator.
      </p>

      <div class="metrics">
        <div>
          <div class="metric-value">85%+</div>
          <div class="metric-label">Detection Accuracy</div>
        </div>
        <div>
          <div class="metric-value">70%</div>
          <div class="metric-label">Faster Dashboards</div>
        </div>
        <div>
          <div class="metric-value">Sub-Second</div>
          <div class="metric-label">Query Performance</div>
        </div>
      </div>

      <div class="tags">
        <div class="tag">Python</div>
        <div class="tag">OpenCV</div>
        <div class="tag">AWS</div>
        <div class="tag">DynamoDB</div>
        <div class="tag">Redis</div>
      </div>

    </div>

  </section>


  <section
    class="section"
    id="studio1">

    <div class="section-inner">

      <div class="section-number">
        03 — Studio1
      </div>

      <h2>
        Studio1
      </h2>

      <div class="section-role">
        Full Stack Developer &amp; DevOps Engineer, <span>Studio1 AI Startup</span> — 2025–2026
      </div>

      <p>
        Production applications in React, Node.js, TypeScript and SQL with
        real-time collaborative features via WebSocket — adopted by Amazon
        Prime to produce content for The Boys franchise. Promoted to lead a
        team of 4 engineers: sprint planning, code review and solution
        architecture. Integrated the OpenAI API with secure key management
        and rate limiting, and authored the team's API Route Rulebook.
      </p>

      <div class="metrics">
        <div>
          <div class="metric-value">500+</div>
          <div class="metric-label">Active Users</div>
        </div>
        <div>
          <div class="metric-value">10,000+</div>
          <div class="metric-label">Daily Requests</div>
        </div>
        <div>
          <div class="metric-value">85%</div>
          <div class="metric-label">Test Coverage</div>
        </div>
        <div>
          <div class="metric-value">60%</div>
          <div class="metric-label">Faster Deploys</div>
        </div>
      </div>

      <div class="tags">
        <div class="tag">React</div>
        <div class="tag">Node.js</div>
        <div class="tag">TypeScript</div>
        <div class="tag">SQL</div>
        <div class="tag">WebSocket</div>
        <div class="tag">GitHub Actions</div>
      </div>

    </div>

  </section>


  <section
    class="section"
    id="ma-ai">

    <div class="section-inner">

      <div class="section-number">
        04 — M&amp;A AI System
      </div>

      <h2>
        Financial Document Intelligence
      </h2>

      <div class="section-role">
        AI Engineering Intern, <span>Fulcrum Digital</span> — M&amp;A AI Report Automation, 2025
      </div>

      <p>
        ML-powered financial analysis system using Python, transformer
        models and LangChain RAG pipelines over SEC filings, built to
        ISO 27001-aligned security standards for sensitive financial data.
        Automated n8n workflows generate reports across 20+ financial
        metrics — revenue, valuation ratios and market indicators.
      </p>

      <div class="metrics">
        <div>
          <div class="metric-value">80–85%</div>
          <div class="metric-label">Prediction Accuracy</div>
        </div>
        <div>
          <div class="metric-value">80%</div>
          <div class="metric-label">Less Manual Analysis</div>
        </div>
      </div>

      <div class="tags">
        <div class="tag">Python</div>
        <div class="tag">LangChain</div>
        <div class="tag">RAG</div>
        <div class="tag">Transformers</div>
        <div class="tag">n8n</div>
      </div>

    </div>

  </section>


  <section
    class="section"
    id="noumena">

    <div class="section-inner">

      <div class="section-number">
        05 — Noumena
      </div>

      <h2>
        Noumena
      </h2>

      <div class="section-role">
        Cybersecurity Intern, <span>Noumena</span> — 2023–2024
      </div>

      <p>
        Monitored live network traffic and blocked malicious access at
        scale using Cloudflare, Datadog and SIEM tooling. Conducted
        enterprise security risk assessments, delivered technical
        presentations to business stakeholders, and resolved live
        security incidents under high-pressure conditions.
      </p>

      <div class="metrics">
        <div>
          <div class="metric-value">100+/min</div>
          <div class="metric-label">Malicious Accesses Blocked</div>
        </div>
        <div>
          <div class="metric-value">50%</div>
          <div class="metric-label">Security Improvement</div>
        </div>
      </div>

      <div class="tags">
        <div class="tag">Cloudflare</div>
        <div class="tag">Datadog</div>
        <div class="tag">SIEM</div>
        <div class="tag">CIA Triad</div>
      </div>

    </div>

  </section>


  <section
    class="section"
    id="feature">

    <div class="section-inner">

      <div class="section-number">
        06 — Recognition
      </div>

      <h2>
        Women of Colour Feature
      </h2>

      <p>
        Recognised for work at the intersection of engineering and
        entrepreneurship — one credential, kept quiet.
      </p>

    </div>

  </section>

</div>


<script>

/* =====================================================
   FRAME CONFIGURATION
===================================================== */

const FRAMES = {
  path: "./frames/",
  prefix: "ezgif-frame-",
  ext: "png",
  start: 1,
  end: 240,
  pad: 3
};


/* =====================================================
   SCROLL SETTINGS
===================================================== */

const SCROLL_LENGTH_VH = 500;
const EASE = 0.25;
const FRAME_END_PROGRESS = 0.50;


/* =====================================================
   ELEMENTS
===================================================== */

const canvas =
  document.getElementById("frame");

const ctx =
  canvas.getContext("2d");

const track =
  document.getElementById("track");

const stage =
  document.getElementById("stage");

const afterBackground =
  document.getElementById("after-background");

const hotspots =
  document.querySelectorAll(".hotspot");

const skillsPanel =
  document.getElementById("skills-panel");

const skillsList =
  skillsPanel.querySelector(".skills-list");

const sectionEls =
  document.querySelectorAll(".section");

const sectionHeadingEls =
  document.querySelectorAll(".section .section-number");


/* =====================================================
   SKILLS PER SECTION
===================================================== */

const SKILLS_BY_SECTION = {
  "ge-vernova": ["Python", "C++", "Kubernetes", "Linux / CLI", "CI/CD"],
  "wakewatch": ["Python", "OpenCV", "AWS (S3, DynamoDB, Lambda)", "Redis", "Predictive Analytics"],
  "studio1": ["React", "Node.js", "TypeScript", "SQL", "WebSocket", "Jest"],
  "ma-ai": ["Python", "LangChain", "RAG Pipelines", "Transformers", "ISO 27001"],
  "noumena": ["Cloudflare", "Datadog", "SIEM", "CIA Triad"],
  "feature": []
};

let activeSkillsSection = null;

/*
  The spill animation (frame 240) and the section content share
  the same scroll track, so the section headings can intersect
  the viewport slightly before the animation has actually let go
  of frame 240. Gate visibility on frameAnimationDone (set in
  updateFrameFromScroll) so "SKILLS" never shows while the purse
  is still on screen.
*/
let frameAnimationDone = false;

function refreshSkillsVisibility(){

  const skills =
    SKILLS_BY_SECTION[activeSkillsSection] || [];

  if(frameAnimationDone && skills.length > 0){

    skillsPanel.classList.add("visible");

  }else{

    skillsPanel.classList.remove("visible");

  }

}

function setActiveSkills(id){

  if(id === activeSkillsSection){
    return;
  }

  activeSkillsSection = id;

  const skills =
    SKILLS_BY_SECTION[id] || [];

  if(skills.length === 0){

    refreshSkillsVisibility();

    return;

  }

  skillsList.classList.add("is-swapping");

  setTimeout(() => {

    skillsList.innerHTML =
      skills
        .map(s => `<div>${s}</div>`)
        .join("");

    skillsList.classList.remove("is-swapping");

    refreshSkillsVisibility();

  }, 300);

}


/* =====================================================
   ACTIVE SECTION OBSERVER
===================================================== */

const sectionObserver = new IntersectionObserver(
  entries => {

    entries.forEach(entry => {

      if(entry.isIntersecting){

        setActiveSkills(entry.target.closest(".section").id);

      }

    });

  },
  {
    rootMargin: "0px 0px 0px 0px",
    threshold: 0
  }
);

sectionHeadingEls.forEach(
  heading => sectionObserver.observe(heading)
);


/* =====================================================
   FRAME STORAGE
===================================================== */

const images = [];

let loaded = 0;

let currentFrame = 0;

let targetFrame = 0;

let lastDrawnFrame = -1;


/* =====================================================
   FRAME URL
===================================================== */

function frameURL(number){

  return (
    FRAMES.path +
    FRAMES.prefix +
    String(number).padStart(
      FRAMES.pad,
      "0"
    ) +
    "." +
    FRAMES.ext
  );

}


/* =====================================================
   PRELOAD FRAMES
===================================================== */

function preloadFrames(){

  for(
    let i = FRAMES.start;
    i <= FRAMES.end;
    i++
  ){

    const img = new Image();

    img.src = frameURL(i);

    img.onload = () => {

      loaded++;

      if(i === FRAMES.start){

        resizeCanvas();

        drawFrame(0);

      }

    };

    img.onerror = () => {

      console.error(
        "Could not load:",
        frameURL(i)
      );

    };

    images.push(img);

  }

}


/* =====================================================
   CANVAS RESIZE
===================================================== */

function resizeCanvas(){

  const dpr =
    Math.min(
      window.devicePixelRatio || 1,
      2
    );

  canvas.width =
    window.innerWidth * dpr;

  canvas.height =
    window.innerHeight * dpr;

  canvas.style.width =
    window.innerWidth + "px";

  canvas.style.height =
    window.innerHeight + "px";

  ctx.setTransform(
    dpr,
    0,
    0,
    dpr,
    0,
    0
  );

  if(
    images[currentFrame]?.complete
  ){

    lastDrawnFrame = -1;

    drawFrame(currentFrame);

  }

}


/* =====================================================
   DRAW FRAME
===================================================== */

function drawFrame(index){

  index = Math.max(
    0,
    Math.min(
      images.length - 1,
      Math.round(index)
    )
  );

  const img =
    images[index];

  if(
    !img ||
    !img.complete ||
    !img.naturalWidth
  ){

    return;

  }

  if(
    lastDrawnFrame === index
  ){

    return;

  }

  lastDrawnFrame = index;

  const cw =
    window.innerWidth;

  const ch =
    window.innerHeight;

  const iw =
    img.naturalWidth;

  const ih =
    img.naturalHeight;


  const scale =
    Math.max(
      cw / iw,
      ch / ih
    );

  const width =
    iw * scale;

  const height =
    ih * scale;

  const x =
    (cw - width) / 2;

  const y =
    (ch - height) / 2;


  ctx.clearRect(
    0,
    0,
    cw,
    ch
  );

  ctx.drawImage(
    img,
    x,
    y,
    width,
    height
  );

}


/* =====================================================
   UPDATE FRAME FROM SCROLL
===================================================== */

/*
  ONLY CHANGE HERE:

  Frames 001 → 240 play during the first
  80% of the scroll.

  The remaining 20% keeps frame 240
  completely static.

  The overall scroll length remains 500vh.
*/

function updateFrameFromScroll(){

  const rect =
    track.getBoundingClientRect();

  const total =
    track.offsetHeight -
    window.innerHeight;

  let p =
    -rect.top / total;

  p =
    Math.max(
      0,
      Math.min(1,p)
    );


  const maxFrame =
    FRAMES.end -
    FRAMES.start;


  /* ==========================================
     FRAME MAPPING
  ========================================== */

  let frameProgress;


  if(p < FRAME_END_PROGRESS){

    frameProgress =
      p / FRAME_END_PROGRESS;

  }else{

    /*
      Once frame 240 is reached,
      keep it there.
    */

    frameProgress = 1;

  }


  targetFrame =
    frameProgress * maxFrame;


  /* ==========================================
     EASING
  ========================================== */

  currentFrame +=
    (targetFrame - currentFrame) *
    EASE;


  /*
    Never go beyond frame 240.
  */

  currentFrame =
    Math.min(
      currentFrame,
      maxFrame
    );


  drawFrame(
    Math.floor(currentFrame)
  );


  /* ==========================================
     FINAL BACKGROUND
  ========================================== */

  if(p >= 0.995){

    afterBackground.classList.add(
      "visible"
    );

    if(!frameAnimationDone){
      frameAnimationDone = true;
      refreshSkillsVisibility();
    }

  }else{

    afterBackground.classList.remove(
      "visible"
    );

    if(frameAnimationDone){
      frameAnimationDone = false;
      refreshSkillsVisibility();
    }

  }


  /* ==========================================
     HOTSPOTS
  ========================================== */

  hotspots.forEach(
    hotspot => {

      if(
        p >= FRAME_END_PROGRESS &&
        p < 0.995
      ){

        hotspot.classList.add(
          "active"
        );

      }else{

        hotspot.classList.remove(
          "active"
        );

      }

    }
  );


}


/* =====================================================
   ANIMATION LOOP
===================================================== */

function animate(){

  updateFrameFromScroll();

  requestAnimationFrame(
    animate
  );

}


/* =====================================================
   HOTSPOT CLICK
===================================================== */

hotspots.forEach(
  hotspot => {

    hotspot.addEventListener(
      "click",
      () => {

        const target =
          document.getElementById(
            hotspot.dataset.target
          );

        if(target){

          target.scrollIntoView({
            behavior:"smooth"
          });

        }

      }
    );

  }
);


/* =====================================================
   RESIZE
===================================================== */

window.addEventListener(
  "resize",
  () => {

    resizeCanvas();

  }
);


/* =====================================================
   START
===================================================== */

preloadFrames();

resizeCanvas();

animate();


/* =====================================================
   REDUCED MOTION
===================================================== */

if(
  window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches
){

  afterBackground.classList.add(
    "visible"
  );

}

</script>

</body>
</html>
